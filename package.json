{
  "name": "assistant-reminder",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "dev:local": "next dev",
    "build": "next build",
    "build:local": "next build",
    "start": "next start",
    "test": "npm run test:unit && npm run typecheck && npm run lint && npm run build",
    "test:unit": "node --import tsx --test lib/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "lint:local": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "notifications:keys": "node --import tsx scripts/generate-vapid-keys.ts",
    "worker:notifications": "node --env-file=.env --import tsx worker/notifications.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.58.5",
    "ioredis": "^5.7.0",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Assistant Reminder"
}
