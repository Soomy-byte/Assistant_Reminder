{
  "name": "assistant-reminder",
  "version": "0.5.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean": "node scripts/clean.mjs",
    "test": "npm run test:unit && npm run typecheck && npm run lint && npm run build",
    "test:unit": "node --import tsx --test lib/**/*.test.ts",
    "test:e2e": "node scripts/prepare-e2e.mjs && playwright test",
    "test:e2e:ci": "playwright test",
    "test:e2e:ui": "node scripts/prepare-e2e.mjs && playwright test --ui",
    "test:e2e:clean": "docker compose -f docker-compose.test.yml down -v",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "notifications:keys": "node --import tsx scripts/generate-vapid-keys.ts",
    "worker:notifications": "node --env-file=.env --import tsx worker/notifications.ts",
    "worker:notifications:test": "node --env-file=.env.test --import tsx worker/notifications.ts",
    "dev:e2e": "node scripts/e2e-server.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.58.5",
    "ioredis": "^5.7.0",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.3",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Assistant Reminder"
}
